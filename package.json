{
  "name": "sophenic",
  "version": "11.0.0",
  "private": true,
  "description": "SOPHENIC 11.0.0 - native full-duplex local Voice, publisher-side OAuth Broker, executable AI connectors and scoped long-term memory.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:web": "next dev --turbopack",
    "dev:desktop": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:3000/desktop/agent && npm run ensure:electron && npm run build:electron && cross-env SOPHENIC_DESKTOP_DEV_URL=http://127.0.0.1:3000/desktop/agent ./node_modules/electron/dist/electron.exe dist-electron/main.js",
    "build": "npm run verify:source && npm run test:sophenic && npm run typecheck && npm run build:web && npm run normalize:standalone && npm run build:electron && npm run desktop:verify && npm run prepare:desktop",
    "build:web": "next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "package:win": "electron-builder --config electron-builder.yml --win nsis --x64",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "verify:source": "node scripts/verify-source.mjs",
    "desktop:verify": "npm run build:electron && node scripts/verify-desktop.mjs",
    "doctor:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-doctor.ps1",
    "verify:package": "node scripts/verify-package.mjs",
    "test:sophenic": "node scripts/test-sophenic.mjs && node scripts/test-sophenic-design.mjs && node scripts/test-sophenic-design-v81.mjs && node scripts/test-sophenic-design-v82.mjs && node scripts/test-sophenic-webdesign.mjs && node scripts/test-sophenic-model3d.mjs",
    "qa": "npm run verify:source && npm run test:sophenic && npm run typecheck",
    "package:win:installer": "electron-builder --config electron-builder.yml --win nsis --x64",
    "normalize:standalone": "node scripts/normalize-standalone.mjs",
    "build:installer": "npm run verify:source && npm run test:sophenic && npm run typecheck && npm run build:web && npm run normalize:standalone && npm run build:electron && npm run desktop:verify && npm run prepare:desktop && npm run package:win:installer && npm run verify:package",
    "test": "npm run test:sophenic",
    "sophenic:start": "npm run dev:desktop",
    "oauth:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./CONFIGURER-OAUTH-DESKTOP.ps1",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "electron:repair": "powershell -NoProfile -ExecutionPolicy Bypass -File ./REPARER-ELECTRON-TAR.ps1",
    "test:design": "node scripts/test-sophenic-design.mjs && node scripts/test-sophenic-design-v81.mjs",
    "test:design-v81": "node scripts/test-sophenic-design-v81.mjs",
    "postinstall": "node scripts/prepare-three-assets.mjs",
    "test:design-v82": "node scripts/test-sophenic-design-v82.mjs",
    "test:webdesign": "node scripts/test-sophenic-webdesign.mjs",
    "test:model3d": "node scripts/test-sophenic-model3d.mjs"
  },
  "dependencies": {
    "@huggingface/inference": "4.13.25",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-switch": "1.2.6",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.23.24",
    "katex": "0.18.1",
    "lucide-react": "0.468.0",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6",
    "next": "15.5.21",
    "next-themes": "0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sonner": "2.0.7",
    "stripe": "20.4.0",
    "tailwind-merge": "3.3.1",
    "ws": "8.18.3",
    "zod": "4.1.5",
    "extract-zip": "2.0.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.12",
    "@types/node": "22.15.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "concurrently": "9.2.1",
    "cross-env": "7.0.3",
    "electron": "37.2.6",
    "electron-builder": "26.0.12",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.21",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2",
    "wait-on": "8.0.4",
    "@types/ws": "8.18.1",
    "playwright": "1.55.0",
    "@types/three": "0.180.0"
  },
  "main": "electron/main.js",
  "overrides": {
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6"
  },
  "author": "SOPHENIC"
}
