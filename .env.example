# SOPHENIC secrets - do not commit real keys

# URL publique de l'application (Supabase/Stripe et liens serveur)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub Desktop — Device Flow officiel (SOPHENIC 10.2.0)
# Le Client ID est public. SOPHENIC possède déjà cette valeur par défaut,
# mais elle peut être surchargée ici.
SOPHENIC_GITHUB_CLIENT_ID=Ov23livNj43OaKhQspRt
# IMPORTANT : aucun Client Secret GitHub n'est requis pour le Device Flow Desktop.
# Dans GitHub Developer settings → OAuth Apps → SOPHENIC AI Developer,
# active "Enable Device Flow".
# La variable suivante reste uniquement pour les anciennes routes OAuth Web/serveur.
SOPHENIC_GITHUB_CLIENT_SECRET=
# PAT manuel optionnel : github_pat_... ou ghp_...
SOPHENIC_GITHUB_TOKEN=

# Vercel Desktop — recommandé : Personal Access Token (Settings → Tokens)
# Les tokens personnels Vercel récents commencent typiquement par vcp_.
# L'interface Plugins → Vercel est la méthode recommandée.
SOPHENIC_VERCEL_TOKEN=

# Vercel OAuth App — optionnel uniquement pour les routes Web si une vraie App
# Vercel avec Client ID/Secret a été créée. Le Desktop 10.2.0 ne simule pas OAuth.
SOPHENIC_VERCEL_CLIENT_ID=
SOPHENIC_VERCEL_CLIENT_SECRET=
SOPHENIC_VERCEL_OAUTH_SCOPES=openid email profile offline_access

# Optionnel si l'origine visible par les fournisseurs diffère de l'origine HTTP reçue
SOPHENIC_OAUTH_BASE_URL=

# Optionnel: clé dédiée au chiffrement AES-GCM des tokens OAuth des routes Web.
# Si absente, SOPHENIC dérive la clé depuis SUPABASE_SERVICE_ROLE_KEY côté serveur.
SOPHENIC_CONNECTIONS_ENCRYPTION_KEY=

# Les autres variables de fournisseurs IA/Supabase utilisées par ton installation
# restent inchangées dans ton .env.local existant.

# SOPHENIC Native Realtime Voice Engine (local-first)
SOPHENIC_VOICE_SERVICE_URL=http://127.0.0.1:8765
# Doit correspondre à SOPHENIC_VOICE_SERVICE_KEY dans voice_engine/.env.
# Cette clé reste dans Electron et n'est jamais exposée au renderer.
SOPHENIC_VOICE_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────
# SOPHENIC Plugin OAuth — valeurs de DISTRIBUTION Desktop uniquement.
# Les Client ID/Secrets des fournisseurs vivent dans oauth-broker/.env sur le
# serveur éditeur, jamais ici en production, jamais dans React.
# ─────────────────────────────────────────────────────────────
SOPHENIC_OAUTH_BROKER_URL=https://connect.sophenic.example
SOPHENIC_OAUTH_BROKER_DISTRIBUTION_KEY=
SOPHENIC_OAUTH_LOOPBACK_PORT=43823
# Mode de test local éditeur seulement. Ne jamais activer dans une distribution.
SOPHENIC_OAUTH_ALLOW_LOCAL_DEV=false

# Variables suivantes: compatibilité de développement local uniquement, lues
# seulement quand SOPHENIC_OAUTH_ALLOW_LOCAL_DEV=true. En production, configure
# les équivalents OAUTH_* dans oauth-broker/.env.
SOPHENIC_OAUTH_VERCEL_CLIENT_ID=
SOPHENIC_OAUTH_VERCEL_CLIENT_SECRET=
SOPHENIC_OAUTH_SUPABASE_CLIENT_ID=
SOPHENIC_OAUTH_SUPABASE_CLIENT_SECRET=
SOPHENIC_OAUTH_CLOUDFLARE_CLIENT_ID=
SOPHENIC_OAUTH_CLOUDFLARE_CLIENT_SECRET=
SOPHENIC_OAUTH_CLOUDFLARE_SCOPES=openid profile email
SOPHENIC_OAUTH_GOOGLE_CLIENT_ID=
SOPHENIC_OAUTH_GOOGLE_CLIENT_SECRET=
SOPHENIC_OAUTH_NOTION_CLIENT_ID=
SOPHENIC_OAUTH_NOTION_CLIENT_SECRET=
SOPHENIC_OAUTH_STRIPE_CLIENT_ID=
SOPHENIC_OAUTH_STRIPE_SECRET_KEY=
SOPHENIC_OAUTH_STRIPE_SCOPE=read_write
SOPHENIC_OAUTH_SHOPIFY_CLIENT_ID=
SOPHENIC_OAUTH_SHOPIFY_CLIENT_SECRET=
SOPHENIC_OAUTH_SHOPIFY_SHOP_DOMAIN=
SOPHENIC_OAUTH_SHOPIFY_SCOPES=read_products,read_orders,write_products
SOPHENIC_OAUTH_WORDPRESS_CLIENT_ID=
SOPHENIC_OAUTH_WORDPRESS_CLIENT_SECRET=
