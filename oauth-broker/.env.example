# SOPHENIC OAuth Broker - configuration EDITEUR uniquement.
# Ne jamais livrer ce fichier rempli dans Electron ni dans un installateur.
OAUTH_PUBLIC_BASE_URL=https://connect.sophenic.example
OAUTH_DISTRIBUTION_KEY=replace-with-a-long-random-value-at-least-32-characters
OAUTH_ALLOWED_LOOPBACK_PORT=43823
OAUTH_SESSION_TTL_SECONDS=300

# Vercel App
OAUTH_VERCEL_CLIENT_ID=
OAUTH_VERCEL_CLIENT_SECRET=

# Supabase OAuth App (Management API)
OAUTH_SUPABASE_CLIENT_ID=
OAUTH_SUPABASE_CLIENT_SECRET=

# Cloudflare OAuth Client
OAUTH_CLOUDFLARE_CLIENT_ID=
OAUTH_CLOUDFLARE_CLIENT_SECRET=
OAUTH_CLOUDFLARE_SCOPES=openid profile email

# Google OAuth Client Web - partagé par Firebase/Gmail/Drive/Calendar
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Notion Public Connection
OAUTH_NOTION_CLIENT_ID=
OAUTH_NOTION_CLIENT_SECRET=

# Stripe Connect
OAUTH_STRIPE_CLIENT_ID=
OAUTH_STRIPE_SECRET_KEY=
OAUTH_STRIPE_SCOPE=read_write

# Shopify App - le domaine de boutique est fourni par chaque utilisateur lors de la connexion
OAUTH_SHOPIFY_CLIENT_ID=
OAUTH_SHOPIFY_CLIENT_SECRET=
OAUTH_SHOPIFY_SCOPES=read_products,read_orders,write_products

# WordPress.com OAuth App
OAUTH_WORDPRESS_CLIENT_ID=
OAUTH_WORDPRESS_CLIENT_SECRET=
